{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // scripts/ are tsx/node CLI entry points wired up in package.json scripts;
  // tests/support/* is aliased in by vitest.config.ts resolve.alias.
  "entry": [
    "scripts/*.ts",
    "scripts/*.mjs",
    "tests/support/*.ts"
  ],

  // Deno project, built and deployed by the Supabase CLI with its own
  // deno.json import map. Not reachable from the Next graph by design.
  "ignorePatterns": [
    "supabase/functions/**"
  ],

  // eslint-config-next resolves via .eslintrc.json "extends": "next/*".
  // react-dom is required at runtime by Next, never imported directly.
  "ignoreDependencies": [
    "eslint-config-next",
    "react-dom"
  ],

  "rules": {
    // Both rules misfire on this codebase: shared type vocabularies are
    // composed in-file, and adapter methods are called through structural
    // Pick<> interfaces rather than on the concrete class.
    "unused-types": "off",
    "unused-class-members": "off"
  }
}
